<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 192 192">
  <defs>
    <linearGradient id="wg" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" style="stop-color:#8b5cf6"/>
      <stop offset="50%" style="stop-color:#a855f7"/>
      <stop offset="100%" style="stop-color:#06b6d4"/>
    </linearGradient>
    <linearGradient id="bg" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" style="stop-color:#0a0a0f"/>
      <stop offset="100%" style="stop-color:#12121a"/>
    </linearGradient>
    <filter id="glow"><feGaussianBlur stdDeviation="4" result="blur"/><feMerge><feMergeNode in="blur"/><feMergeNode in="SourceGraphic"/></feMerge></filter>
  </defs>
  
  <rect width="192" height="192" rx="42" fill="url(#bg)"/>
  
  <!-- Waveform -->
  <g transform="translate(96, 96)" filter="url(#glow)">
    <rect x="-6" y="-54" width="12" height="108" rx="6" fill="url(#wg)"/>
    <rect x="-27" y="-35" width="10" height="70" rx="5" fill="url(#wg)" opacity="0.92"/>
    <x="17" y="-39" width="10" height="78" rx="5" fill="url(#wg)" opacity="0.88"/>
    <rect x="-46" y="-23" width="8" height="46" rx="4" fill="url(#wg)" opacity="0.72"/>
    <rect x="38" y="-27" width="8" height="54" rx="4" fill="url(#wg)" opacity="0.68"/>
    <rect x="-63" y="-12" width="7" height="24" rx="3.5" fill="url(#wg)" opacity="0.48"/>
    <rect x="56" y="-15" width="7" height="30" rx="3.5" fill="url(#wg)" opacity="0.42"/>
    <ellipse cx="0" cy="0" rx="68" ry="74" fill="url(#wg)" opacity="0.12"/>
  </g>
  
  <rect width="192" height="192" rx="42" fill="white" opacity="0.03"/>
</svg>